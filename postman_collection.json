{
  "info": {
    "name": "muambr-api Collection",
    "description": "Product Comparison API\n\nPrimary endpoint:\n- POST /api/v1/product-comparisons\n\nAlso:\n- GET /api/v1/linkpreview\n- GET /rates/exchange-rates\n- GET /health\n\nSee docs/PRODUCT_COMPARISON_MOBILE.md for the full contract.\n\nSupported countries: BR, US, PT, ES, DE, GB",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "description": "Base URL for the API"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Product Comparison - Manual (US vs BR)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": {\n    \"name\": \"Sony WH-1000XM6\",\n    \"brand\": \"Sony\",\n    \"model\": \"WH-1000XM6\",\n    \"category\": \"electronics\"\n  },\n  \"observedPrice\": {\n    \"amount\": 349,\n    \"currency\": \"USD\",\n    \"country\": \"US\",\n    \"store\": \"Amazon US\"\n  },\n  \"currentCountry\": \"US\",\n  \"baseCountry\": \"BR\",\n  \"currency\": \"BRL\",\n  \"limit\": 5,\n  \"source\": {\n    \"type\": \"manual\",\n    \"store\": \"Amazon US\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/product-comparisons",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "product-comparisons"]
        }
      }
    },
    {
      "name": "Product Comparison - Same Country (BR)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": {\n    \"name\": \"Sony WH-1000XM6\",\n    \"category\": \"electronics\"\n  },\n  \"observedPrice\": {\n    \"amount\": 2499,\n    \"currency\": \"BRL\"\n  },\n  \"currentCountry\": \"BR\",\n  \"baseCountry\": \"BR\",\n  \"limit\": 5,\n  \"source\": {\n    \"type\": \"manual\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/product-comparisons",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "product-comparisons"]
        }
      }
    },
    {
      "name": "Product Comparison - URL Flow",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"baseCountry\": \"BR\",\n  \"currentCountry\": \"US\",\n  \"product\": {\n    \"category\": \"electronics\"\n  },\n  \"productURL\": \"https://www.amazon.com/dp/B0D1XD1ZV3\",\n  \"source\": {\n    \"type\": \"url\",\n    \"url\": \"https://www.amazon.com/dp/B0D1XD1ZV3\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/product-comparisons",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "product-comparisons"]
        }
      }
    },
    {
      "name": "Product Comparison - Macro Region",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": {\n    \"name\": \"iPhone 15\",\n    \"category\": \"electronics\"\n  },\n  \"observedPrice\": {\n    \"amount\": 999,\n    \"currency\": \"EUR\"\n  },\n  \"currentCountry\": \"ES\",\n  \"baseCountry\": \"PT\",\n  \"currency\": \"EUR\",\n  \"useMacroRegion\": true,\n  \"limit\": 5,\n  \"source\": {\n    \"type\": \"manual\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/product-comparisons",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "product-comparisons"]
        }
      }
    },
    {
      "name": "Product Comparison - Invalid Country",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": {\n    \"name\": \"test\"\n  },\n  \"baseCountry\": \"XX\",\n  \"currentCountry\": \"US\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/product-comparisons",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "product-comparisons"]
        }
      }
    },
    {
      "name": "Product Comparison - Missing Product Name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": {},\n  \"baseCountry\": \"BR\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/product-comparisons",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "product-comparisons"]
        }
      }
    },
    {
      "name": "Link Preview - Amazon Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/linkpreview?url=https://amazon.es/dp/B0C1JJQMTC&baseCountry=PT",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "linkpreview"],
          "query": [
            {
              "key": "url",
              "value": "https://amazon.es/dp/B0C1JJQMTC"
            },
            {
              "key": "baseCountry",
              "value": "PT"
            }
          ]
        }
      }
    },
    {
      "name": "Link Preview - With Comparisons",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/linkpreview?url=https://www.amazon.com/dp/B0D1XD1ZV3&baseCountry=BR&addComparisons=true",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "linkpreview"],
          "query": [
            {
              "key": "url",
              "value": "https://www.amazon.com/dp/B0D1XD1ZV3"
            },
            {
              "key": "baseCountry",
              "value": "BR"
            },
            {
              "key": "addComparisons",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "Exchange Rates",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/rates/exchange-rates?baseCurrency=USD",
          "host": ["{{base_url}}"],
          "path": ["rates", "exchange-rates"],
          "query": [
            {
              "key": "baseCurrency",
              "value": "USD"
            }
          ]
        }
      }
    }
  ]
}
